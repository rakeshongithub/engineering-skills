  "description": {
    "brief": "Design, validate, and optimize comprehensive backup and disaster recovery strategies for modern software systems.",
    "detailed": "This skill enables AI agents to analyze existing backup approaches, identify gaps, design multi-tier recovery solutions, calculate RTO/RPO targets, implement best practices across diverse technology stacks, and ensure business continuity through comprehensive backup and disaster recovery strategies.",
    "businessValue": [
      "Minimize data loss and downtime during failures",
      "Ensure regulatory compliance (GDPR, HIPAA, SOX, PCI DSS)",
      "Reduce financial impact of data loss events",
      "Maintain customer trust through reliable data protection",
      "Optimize backup costs while meeting recovery objectives"
    ]
  },
  "prerequisites": {
    "technicalKnowledge": [
      "Storage systems (block, file, object storage)",
      "Database technologies (relational and NoSQL)",
      "Cloud infrastructure (AWS, Azure, GCP)",
      "Networking fundamentals",
      "Basic disaster recovery concepts"
    ],
    "skills": [
      "infrastructure-monitoring",
      "cloud-infrastructure-management",
      "database-administration"
    ],
    "tools": [
      "Backup software (Veeam, Commvault, Rubrik)",
      "Cloud backup services (AWS Backup, Azure Backup)",
      "Monitoring tools (CloudWatch, Prometheus, Grafana)",
      "Infrastructure as Code (Terraform, CloudFormation)"
    ],
    "access": [
      "Infrastructure and architecture documentation",
      "Backup system administrative access",
      "Cloud console permissions",
      "Database backup procedure access"
    ]
  },
  "targetAudience": [
    "DevOps Engineers",
